# cp .env.example .env
# Never put real secrets in this file — it is committed to git.

# ── Required ─────────────────────────────────────────
# Visual Crossing API key. Sign up for free at https://www.visualcrossing.com/
# and copy your key from your account page.
WEATHER_API_KEY=your-visual-crossing-api-key

# ── Optional (defaults are set in config.py) ─────────
# Base URL of the Visual Crossing Timeline API.
# API_BASE_URL=https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services/timeline

# URL of the Redis Cache database
# REDIS_URL=redis://127.0.0.1:6379/0

# How long cached weather responses are kept in Redis, in seconds (default: 12 hours).
# CACHE_TTL_SECONDS=43200

# How long the Middleware should wait for the upstream API response (default: 3 seconds).
# API_TIMEOUT_SECONDS=3.0
